<Window x:Class="Collector.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Collector.Wpf.ViewModels"
        Title="M365 Discovery Collector" 
        Height="800" 
        Width="1200"
        WindowStartupLocation="CenterScreen">
    
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
        
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        
        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0078D4" Padding="15" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="M365 Discovery Collector" 
                          FontSize="24" 
                          FontWeight="Bold" 
                          Foreground="White"/>
                <TextBlock Text="Collect Entra ID, SharePoint, Teams, OneDrive, and Exchange data" 
                          FontSize="12" 
                          Foreground="White" 
                          Opacity="0.9"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <TabControl Grid.Row="1">
            <!-- Configuration Tab -->
            <TabItem Header="⚙️ Configuration">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Authentication -->
                        <GroupBox Grid.Column="0" Header="Authentication">
                            <StackPanel>
                                <TextBlock Text="Select Authentication Mode:" FontWeight="Bold" Margin="0,0,0,10"/>
                                
                                <RadioButton Content="Interactive Delegated (User Sign-In)" 
                                           IsChecked="{Binding IsInteractiveDelegated}"
                                           Margin="0,5"/>
                                <TextBlock Text="User will sign in interactively with their account" 
                                         FontSize="10" 
                                         Foreground="Gray" 
                                         Margin="20,0,0,10"
                                         TextWrapping="Wrap"/>

                                <RadioButton Content="App-Only (Service Principal)" 
                                           IsChecked="{Binding IsAppOnly}"
                                           Margin="0,5"/>
                                <TextBlock Text="Unattended authentication using client secret" 
                                         FontSize="10" 
                                         Foreground="Gray" 
                                         Margin="20,0,0,15"
                                         TextWrapping="Wrap"/>

                                <Separator Margin="0,10"/>

                                <TextBlock Text="Client ID (Application ID):" FontWeight="Bold" Margin="0,10,0,5"/>
                                <TextBox Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Text="Tenant ID:" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding TenantId, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Text="Client Secret:" 
                                         FontWeight="Bold" 
                                         Margin="0,0,0,5"
                                         Visibility="{Binding IsAppOnly, Converter={StaticResource BoolToVis}}"/>
                                <PasswordBox x:Name="ClientSecretBox"
                                           Visibility="{Binding IsAppOnly, Converter={StaticResource BoolToVis}}"
                                           PasswordChanged="ClientSecretBox_PasswordChanged"/>

                                <Border Background="#FFF3CD" 
                                      BorderBrush="#FFE5A3" 
                                      BorderThickness="1" 
                                      Padding="10" 
                                      Margin="0,10,0,0"
                                      Visibility="{Binding IsInteractiveDelegated, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="ℹ️ Interactive Mode" FontWeight="Bold" Foreground="#856404"/>
                                        <TextBlock Text="You will be prompted to sign in when you start the discovery."
                                                 TextWrapping="Wrap"
                                                 Foreground="#856404"
                                                 Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#D1ECF1" 
                                      BorderBrush="#BEE5EB" 
                                      BorderThickness="1" 
                                      Padding="10" 
                                      Margin="0,10,0,0"
                                      Visibility="{Binding IsAppOnly, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="ℹ️ App Registration Required" FontWeight="Bold" Foreground="#0C5460"/>
                                        <TextBlock TextWrapping="Wrap" Foreground="#0C5460" Margin="0,5,0,0">
                                            <Run Text="Required Application Permissions:"/>
                                            <LineBreak/>
                                            <Run Text="• Directory.Read.All"/>
                                            <LineBreak/>
                                            <Run Text="• Reports.Read.All"/>
                                            <LineBreak/>
                                            <Run Text="• Organization.Read.All"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </GroupBox>

                        <!-- Output Settings -->
                        <GroupBox Grid.Column="1" Header="Output Settings">
                            <StackPanel>
                                <TextBlock Text="Output Folder:" FontWeight="Bold" Margin="0,0,0,5"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" 
                                           Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" 
                                           IsReadOnly="True"/>
                                    <Button Grid.Column="1" 
                                          Content="Browse..." 
                                          Command="{Binding BrowseOutputFolderCommand}"
                                          Margin="5,0,0,10"
                                          Padding="10,5"/>
                                </Grid>

                                <Button Content="📁 Open Output Folder" 
                                      Command="{Binding OpenOutputFolderCommand}"
                                      Padding="10"
                                      Margin="0,10,0,0"/>

                                <Separator Margin="0,20"/>

                                <TextBlock Text="Output Files:" FontWeight="Bold" Margin="0,0,0,10"/>
                                <TextBlock TextWrapping="Wrap" Foreground="Gray">
                                    The following files will be generated:
                                    <LineBreak/>
                                    <LineBreak/>
                                    • Entra_Users.csv
                                    <LineBreak/>
                                    • Entra_Groups.csv
                                    <LineBreak/>
                                    • Entra_M365Groups.csv
                                    <LineBreak/>
                                    • SPO_SiteUsage.csv
                                    <LineBreak/>
                                    • OD_Usage.csv
                                    <LineBreak/>
                                    • Teams_Usage.csv
                                    <LineBreak/>
                                    • EXO_MailboxUsage.csv
                                    <LineBreak/>
                                    • Organization.json
                                    <LineBreak/>
                                    • Summary.csv
                                    <LineBreak/>
                                    • RunMetadata.json
                                    <LineBreak/>
                                    • Discovery_AccessGaps.csv
                                </TextBlock>
                            </StackPanel>
                        </GroupBox>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- Workload Selection Tab -->
            <TabItem Header="📋 Workload Selection">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
                        <Button Content="✓ Select All" 
                              Command="{Binding SelectAllWorkloadsCommand}"
                              Padding="10,5"
                              Margin="0,0,10,0"/>
                        <Button Content="✗ Deselect All" 
                              Command="{Binding DeselectAllWorkloadsCommand}"
                              Padding="10,5"/>
                    </StackPanel>

                    <!-- Workload List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Workloads}" Margin="10">
                            <ItemsControl.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <Border Background="#F0F0F0" 
                                                  Padding="10" 
                                                  Margin="0,10,0,5">
                                                <TextBlock Text="{Binding Name}" 
                                                         FontWeight="Bold" 
                                                         FontSize="14"/>
                                            </Border>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ItemsControl.GroupStyle>

                            <ItemsControl.ItemsSource>
                                <Binding>
                                    <Binding.Source>
                                        <CollectionViewSource Source="{Binding Workloads}">
                                            <CollectionViewSource.GroupDescriptions>
                                                <PropertyGroupDescription PropertyName="Category"/>
                                            </CollectionViewSource.GroupDescriptions>
                                        </CollectionViewSource>
                                    </Binding.Source>
                                </Binding>
                            </ItemsControl.ItemsSource>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E0E0E0" 
                                          BorderThickness="1" 
                                          Padding="10" 
                                          Margin="0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0" 
                                                    IsChecked="{Binding IsSelected}"
                                                    VerticalAlignment="Center"
                                                    IsEnabled="{Binding DataContext.IsRunning, 
                                                               RelativeSource={RelativeSource AncestorType=Window},
                                                               Converter={StaticResource InverseBoolConverter}}"/>

                                            <StackPanel Grid.Column="1" Margin="10,0">
                                                <TextBlock Text="{Binding DisplayName}" 
                                                         FontWeight="Bold" 
                                                         FontSize="13"/>
                                                <TextBlock Text="{Binding Description}" 
                                                         FontSize="11" 
                                                         Foreground="Gray"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" 
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Status}" 
                                                         FontSize="11"
                                                         HorizontalAlignment="Right"/>
                                                <ProgressBar Width="100" 
                                                           Height="4" 
                                                           IsIndeterminate="True"
                                                           Margin="0,5,0,0"
                                                           Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- Progress Tab -->
            <TabItem Header="📊 Progress & Logs">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Status Panel -->
                    <Border Grid.Row="0" 
                          Background="#F8F9FA" 
                          BorderBrush="#DEE2E6" 
                          BorderThickness="0,0,0,1" 
                          Padding="15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" 
                                     Text="{Binding StatusMessage}" 
                                     FontSize="16" 
                                     FontWeight="Bold"/>
                            
                            <TextBlock Grid.Row="1" 
                                     Text="{Binding CurrentActivity}" 
                                     FontSize="12" 
                                     Foreground="Gray"
                                     Margin="0,5,0,10"/>

                            <ProgressBar Grid.Row="2" 
                                       Height="25" 
                                       Value="{Binding ProgressPercentage}" 
                                       Minimum="0" 
                                       Maximum="100"/>
                        </Grid>
                    </Border>

                    <!-- Log Output -->
                    <Border Grid.Row="1" 
                          Background="Black" 
                          Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                    x:Name="LogScrollViewer">
                            <ItemsControl ItemsSource="{Binding LogMessages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" 
                                                 Foreground="#00FF00" 
                                                 FontFamily="Consolas" 
                                                 FontSize="11"
                                                 TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Action Bar -->
        <Border Grid.Row="2" 
              Background="#F8F9FA" 
              BorderBrush="#DEE2E6" 
              BorderThickness="0,1,0,0" 
              Padding="15"
              Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Ready" 
                             VerticalAlignment="Center"
                             Visibility="{Binding IsRunning, Converter={StaticResource InverseBoolVisConverter}}"/>
                    <TextBlock Text="Discovery in progress..." 
                             VerticalAlignment="Center"
                             Foreground="#0078D4"
                             FontWeight="Bold"
                             Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>

                <Button Grid.Column="1" 
                      Content="▶️ Start Discovery" 
                      Command="{Binding StartDiscoveryCommand}"
                      Padding="20,10"
                      FontSize="14"
                      FontWeight="Bold"
                      Background="#0078D4"
                      Foreground="White"
                      BorderThickness="0"/>
            </Grid>
        </Border>
    </Grid>
</Window>