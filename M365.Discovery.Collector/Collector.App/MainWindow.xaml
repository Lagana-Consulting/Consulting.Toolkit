<Window x:Class="Collector.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Collector.App.ViewModels"
        mc:Ignorable="d"
        Title="M365 Discovery Collector V2" Height="865" Width="1300" MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- Expander Header Style -->
        <Style x:Key="CategoryExpanderStyle" TargetType="Expander">
            <Setter Property="IsExpanded" Value="True"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        
        <!-- Migration Risk Flag Icon Style -->
        <Style x:Key="RiskFlagStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16,16,16,0">
        <!-- Footer - docked to bottom first -->
        <Border DockPanel.Dock="Bottom" 
                Background="#F5F5F5" 
                Padding="8" 
                Margin="-16,12,-16,-16"
                BorderBrush="#DDDDDD" 
                BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding FooterText}" VerticalAlignment="Center"/>
        </Border>

        <!-- Header - docked to top -->
        <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="M365 Discovery Collector V2" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="Entra ID and Microsoft 365 workload discovery" Opacity="0.75"/>
            </StackPanel>

            <!-- Scrollable button area -->
            <ScrollViewer DockPanel.Dock="Right" 
                          HorizontalScrollBarVisibility="Auto" 
                          VerticalScrollBarVisibility="Disabled"
                          VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ADMIN SETUP:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.7" FontSize="11"/>
                    <Button Content="🔐 Admin Sign In" Command="{Binding BootstrapSignInCommand}" Margin="0,0,4,0" Padding="6,4" FontSize="11"/>
                    <Button Content="📝 Create App" Command="{Binding CreateAppRegistrationCommand}" Margin="0,0,4,0" Padding="6,4" FontSize="11"/>
                    <Button Content="🔑 Add Perms" Command="{Binding AddPermissionsCommand}" Margin="0,0,4,0" Padding="6,4" FontSize="11"/>
                    <Button Content="✅ Consent" Command="{Binding RequestAdminConsentCommand}" Margin="0,0,12,0" Padding="6,4" FontSize="11"/>
                    <Button Content="🔄 Reset" Command="{Binding ResetConfigCommand}" Margin="0,0,4,0" Padding="6,4" FontSize="11" ToolTip="Clear saved configuration"/>
                    
                    <Rectangle Width="1" Fill="#DDDDDD" Margin="0,4"/>
                    
                    <TextBlock Text="USER:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,8,0" Opacity="0.7" FontSize="11"/>
                    <ToggleButton Content="Bootstrap Admin Role"
                                  IsChecked="{Binding IsBootstrapAdminRole, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="0,0,8,0"
                                  Padding="6,4"
                                  FontSize="11"/>
                    <Border Background="#E6F2FF"
                            BorderBrush="#7AA7D9"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="6,3"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding ActiveRoleLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#124A8A"/>
                    </Border>
                    <Button Content="⚙ Configure Auth" Command="{Binding ConfigureAuthCommand}" Margin="0,0,8,0"/>
                    <Button Content="🔐 Sign In" Command="{Binding SignInCommand}" Margin="0,0,8,0"/>
                    
                    <Border Background="#FFF4CE"
                            BorderBrush="#FFB900"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="6,3"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding RequiresReauthentication, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Auth stale - Sign in required" FontSize="11" FontWeight="SemiBold" Foreground="#8A5100"/>
                    </Border>
                    <Button Content="🔄 Refresh Sign-In"
                            Command="{Binding SignInCommand}"
                            Margin="0,0,8,0"
                            Padding="6,4"
                            FontSize="11"
                            Visibility="{Binding RequiresReauthentication, Converter={StaticResource BoolToVis}}"/>

                    <Button Content="Preflight Check" Command="{Binding PreflightCommand}" Margin="0,0,8,0"/>
                    
                    <Button Content="ℹ️ Hashed Names?" 
                            Command="{Binding ShowReportsPrivacyHelpCommand}"
                            ToolTip="Learn about report data privacy settings"
                            Padding="6,4" 
                            FontSize="11"/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- Main content: Split - fills remaining space -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" MinWidth="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Workload selection + config -->
            <Border Grid.Column="0" BorderBrush="#DDDDDD" BorderThickness="0,0,1,0" Padding="0,0,12,0">
                <DockPanel>
                    <!-- Config at top -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="Configuration" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        
                        <Label Content="Output Folder:" Padding="0,0,0,4"/>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="Open" Command="{Binding OpenOutputFolderCommand}" Margin="4,0,0,0" Padding="4,2"/>
                            <Button DockPanel.Dock="Right" Content="Browse..." Command="{Binding BrowseFolderCommand}" Margin="4,0,0,0" Padding="4,2"/>
                            <TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" Padding="4,2"/>
                        </DockPanel>

                        <Label Content="Run Name:" Padding="0,0,0,4"/>
                        <TextBox Text="{Binding RunName, UpdateSourceTrigger=PropertyChanged}" Padding="4,2"/>

                        <Label Content="Report Days:" Padding="0,6,0,4"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      Width="90"
                                      ItemsSource="{Binding ReportDayOptions}"
                                      SelectedItem="{Binding ReportDays, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Column="1"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="Usage reports support 7, 30, 90, or 180 days."
                                       Opacity="0.7"
                                       TextWrapping="Wrap"/>
                        </Grid>

                        <Separator Margin="0,10,0,8"/>
                        <TextBlock Text="Sign-In Mode" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <CheckBox Content="Use app-only certificate sign-in"
                                  IsChecked="{Binding UseAppOnlyCertificateSignIn, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="0,0,0,6"/>

                        <Label Content="Tenant ID / Domain:" Padding="0,0,0,4"/>
                        <TextBox Text="{Binding TenantId, UpdateSourceTrigger=PropertyChanged}" Padding="4,2"/>

                        <Label Content="Certificate Thumbprint (preferred):" Padding="0,6,0,4"/>
                        <TextBox Text="{Binding CertificateThumbprint, UpdateSourceTrigger=PropertyChanged}" Padding="4,2"/>

                        <Label Content="Certificate Subject Name (alternative):" Padding="0,6,0,4"/>
                        <TextBox Text="{Binding CertificateSubjectName, UpdateSourceTrigger=PropertyChanged}" Padding="4,2"/>
                    </StackPanel>

                    <!-- Run button at bottom - ALWAYS VISIBLE -->
                    <Button DockPanel.Dock="Bottom" 
                            Content="▶ Run Selected Workloads" 
                            Command="{Binding RunSelectedCommand}" 
                            Padding="12,8" 
                            FontWeight="SemiBold" 
                            Margin="0,12,0,0"
                            Background="#0078D4"
                            Foreground="White"
                            BorderThickness="0"/>

                    <!-- Workload selection - GROUPED BY SERVICE TYPE -->
                    <GroupBox Header="Select Workloads to Collect">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="Deselect All"
                                        Command="{Binding DeselectAllWorkloadsCommand}"
                                        Margin="0,0,6,0"
                                        Padding="6,3"
                                        FontSize="11"/>
                                <Button Content="Enable Entra ID"
                                        Command="{Binding EnableEntraWorkloadsCommand}"
                                        Margin="0,0,6,0"
                                        Padding="6,3"
                                        FontSize="11"/>
                                <Button Content="Enable Microsoft 365"
                                        Command="{Binding EnableMicrosoft365WorkloadsCommand}"
                                        Padding="6,3"
                                        FontSize="11"/>
                            </StackPanel>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                <!-- ENTRA ID CATEGORY -->
                                <Expander Style="{StaticResource CategoryExpanderStyle}" IsExpanded="True">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🔐" FontSize="16" Margin="0,0,8,0"/>
                                            <TextBlock Text="Entra ID" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding EntraIdWorkloadCount}" 
                                                       Foreground="Gray" 
                                                       FontSize="11" 
                                                       Margin="8,0,0,0" 
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Expander.Header>
                                    <ItemsControl ItemsSource="{Binding EntraIdWorkloads}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="8,4" BorderBrush="#EEEEEE" BorderThickness="0,0,0,1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Description}" Opacity="0.6" FontSize="11" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="11" Margin="0,2,0,0"/>
                                                        </StackPanel>

                                                        <Border Grid.Column="2" 
                                                                Width="10" Height="10" 
                                                                CornerRadius="5" 
                                                                Background="{Binding StatusBrush}" 
                                                                VerticalAlignment="Center"
                                                                Margin="8,0,0,0"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>

                                <!-- MICROSOFT 365 CATEGORY -->
                                <Expander Style="{StaticResource CategoryExpanderStyle}" IsExpanded="True">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="☁️" FontSize="16" Margin="0,0,8,0"/>
                                            <TextBlock Text="Microsoft 365" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Microsoft365WorkloadCount}" 
                                                       Foreground="Gray" 
                                                       FontSize="11" 
                                                       Margin="8,0,0,0" 
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Expander.Header>
                                    <ItemsControl ItemsSource="{Binding Microsoft365Workloads}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="8,4" BorderBrush="#EEEEEE" BorderThickness="0,0,0,1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Description}" Opacity="0.6" FontSize="11" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="11" Margin="0,2,0,0"/>
                                                        </StackPanel>

                                                        <Border Grid.Column="2" 
                                                                Width="10" Height="10" 
                                                                CornerRadius="5" 
                                                                Background="{Binding StatusBrush}" 
                                                                VerticalAlignment="Center"
                                                                Margin="8,0,0,0"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>

                                <!-- ORGANIZATION CATEGORY -->
                                <Expander Style="{StaticResource CategoryExpanderStyle}" IsExpanded="True">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🏢" FontSize="16" Margin="0,0,8,0"/>
                                            <TextBlock Text="Organization" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Expander.Header>
                                    <ItemsControl ItemsSource="{Binding OrganizationWorkloads}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="8,4" BorderBrush="#EEEEEE" BorderThickness="0,0,0,1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Description}" Opacity="0.6" FontSize="11" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="11" Margin="0,2,0,0"/>
                                                        </StackPanel>

                                                        <Border Grid.Column="2" 
                                                                Width="10" Height="10" 
                                                                CornerRadius="5" 
                                                                Background="{Binding StatusBrush}" 
                                                                VerticalAlignment="Center"
                                                                Margin="8,0,0,0"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </GroupBox>
                </DockPanel>
            </Border>

            <!-- Right: Log output -->
            <Border Grid.Column="1" Padding="12,0,0,0">
                <GroupBox Header="Activity Log">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBox Text="{Binding LogText, Mode=OneWay}" 
                                 IsReadOnly="True" 
                                 TextWrapping="Wrap" 
                                 BorderThickness="0" 
                                 FontFamily="Consolas" 
                                 FontSize="11"
                                 Background="Transparent"/>
                    </ScrollViewer>
                </GroupBox>
            </Border>
        </Grid>
    </DockPanel>
</Window>
