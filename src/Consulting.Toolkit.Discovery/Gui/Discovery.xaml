<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Active Directory Discovery - Consulting Toolkit" Width="1260" Height="890"
        MinWidth="1060" MinHeight="740" WindowStartupLocation="CenterScreen"
        Background="#F3F6FB" Foreground="#1B2940" FontFamily="Segoe UI" FontSize="13">
  <Window.Resources>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="10,7"/><Setter Property="BorderBrush" Value="#CFD8E6"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="White"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,7"/><Setter Property="MinHeight" Value="34"/></Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="15,9"/><Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#253958"/><Setter Property="BorderBrush" Value="#CFD8E6"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="MinHeight" Value="36"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.8"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Label" TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,6"/></Style>
    <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="Foreground" Value="#64748B"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="12"/></Style>
    <Style TargetType="TabItem"><Setter Property="Padding" Value="20,11"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  </Window.Resources>
  <Grid Margin="26,22,26,18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,22">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Background="#1764D8" CornerRadius="9" Width="48" Height="48" Margin="0,0,14,0"><TextBlock Text="AD" Foreground="White" FontWeight="Bold" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <StackPanel Grid.Column="1"><TextBlock Text="Active Directory Discovery" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Configure a run. Collect inventory. Review the evidence." Foreground="#64748B" Margin="0,3,0,0"/></StackPanel>
      <Border Name="StateBadge" Grid.Column="2" CornerRadius="14" Background="#E4EDFC" Padding="16,7" VerticalAlignment="Center"><TextBlock Name="StateText" Text="Ready" Foreground="#1764D8" FontWeight="SemiBold"/></Border>
    </Grid>
    <TabControl Name="MainTabs" Grid.Row="1" Background="Transparent" BorderThickness="0">
      <TabItem Header="Configure">
        <Grid Margin="0,16,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Background="White" CornerRadius="8" Padding="22" BorderBrush="#E0E7F1" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Name="SettingsPanel" Margin="0,0,8,0">
                <TextBlock Text="Discovery settings" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,17"/>
                <Grid Margin="0,0,0,15">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="Environment" Style="{StaticResource Label}"/><ComboBox Name="EnvironmentInput" IsEditable="True" Text="Source" ToolTip="A label for the environment being collected"><ComboBoxItem Content="Source"/><ComboBoxItem Content="Target"/><ComboBoxItem Content="Production"/><ComboBoxItem Content="Test"/></ComboBox></StackPanel>
                  <StackPanel Grid.Column="2"><TextBlock Text="Customer name" Style="{StaticResource Label}"/><TextBox Name="CustomerInput" ToolTip="Optional customer label in the run metadata"/></StackPanel>
                </Grid>
                <TextBlock Text="Output folder" Style="{StaticResource Label}"/>
                <DockPanel Margin="0,0,0,5"><Button Name="BrowseOutputButton" DockPanel.Dock="Right" Content="Browse..." Margin="8,0,0,0"/><TextBox Name="OutputInput" Text="C:\Discovery" ToolTip="Root folder for a new timestamped discovery run"/></DockPanel>
                <TextBlock Text="Each run creates its own timestamped folder here." Style="{StaticResource Hint}" Margin="0,0,0,16"/>
                <TextBlock Text="Domain controller / server" Style="{StaticResource Label}"/>
                <TextBox Name="ServerInput" ToolTip="Optional initial domain controller; leave blank for automatic selection"/>
                <TextBlock Text="Optional. Leave blank for automatic selection." Style="{StaticResource Hint}" Margin="0,5,0,16"/>
                <TextBlock Text="Domains to collect" Style="{StaticResource Label}"/>
                <TextBox Name="DomainsInput" AcceptsReturn="True" Height="68" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" ToolTip="Domain DNS names, separated by lines, commas, or semicolons"/>
                <TextBlock Text="Leave blank for all domains. Enter one DNS name per line, or separate names with commas. Forest datasets are always included." Style="{StaticResource Hint}" Margin="0,5,0,16"/>
                <Border Background="#EFF5FF" BorderBrush="#D5E4FC" BorderThickness="1" CornerRadius="6" Padding="13" Margin="0,0,0,10">
                  <StackPanel><CheckBox Name="SecurityInput" Content="Include security inventory" FontWeight="SemiBold"/><TextBlock Text="Adds privileged groups, delegation, Kerberos, certificate services, and related security inventory. Collection can take longer." Style="{StaticResource Hint}" Margin="23,5,0,0"/></StackPanel>
                </Border>
                <Expander Header="Advanced PowerShell options" Name="AdvancedExpander">
                  <StackPanel Margin="0,12,0,0"><TextBlock Text="Optional common parameters for the selected engine. Interactive prompts cannot be answered in the background runner." Style="{StaticResource Hint}" Margin="0,0,0,12"/><Grid Name="CommonOptionsGrid"/></StackPanel>
                </Expander>
              </StackPanel>
            </ScrollViewer>
          </Border>
          <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,5,0">
            <Border Background="White" CornerRadius="8" Padding="20" BorderBrush="#E0E7F1" BorderThickness="1" Margin="0,0,0,14">
              <StackPanel><TextBlock Text="Run with" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/><ComboBox Name="EngineInput" DisplayMemberPath="Name" ToolTip="PowerShell executable used by the background collector"/><TextBlock Name="AccountText" Style="{StaticResource Hint}" Margin="0,10,0,0"/><TextBlock Text="Requires RSAT Active Directory tools and read access to the selected domains. The collector writes inventory files; it does not change directory objects." Style="{StaticResource Hint}" Margin="0,10,0,0"/>
                <CheckBox Name="AlternateCredentialInput" Content="Use alternate directory credentials" FontWeight="SemiBold" Margin="0,16,0,0"/>
                <StackPanel Name="CredentialsPanel" Visibility="Collapsed" Margin="0,14,0,0">
                  <TextBlock Text="Account name" Style="{StaticResource Label}"/><TextBox Name="CredentialUserInput" ToolTip="DOMAIN\user or user@domain"/>
                  <TextBlock Text="Password" Style="{StaticResource Label}" Margin="0,12,0,6"/>
                  <PasswordBox Name="CredentialPasswordInput" Padding="10,7" MinHeight="34" BorderBrush="#CFD8E6" BorderThickness="1" ToolTip="Used only for this launch; never saved in settings or logs"/>
                  <TextBlock Text="Use DOMAIN\user or user@domain. Passwords are cleared after a launch attempt. For another forest, specify a server in that forest." Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                  <TextBlock Text="Alternate credentials apply to network access. Local files use your signed-in Windows account." Style="{StaticResource Hint}" Margin="0,7,0,0"/>
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="8" Padding="20" BorderBrush="#E0E7F1" BorderThickness="1">
              <StackPanel><DockPanel><Button Name="CopyCommandButton" Content="Copy" DockPanel.Dock="Right" Padding="12,5" MinHeight="28"/><TextBlock Text="Command preview" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
                <TextBox Name="CommandPreview" IsReadOnly="True" FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="225" Background="#F7F9FC" Margin="0,12,0,10" VerticalContentAlignment="Top"/>
                <WrapPanel><Button Name="LoadSettingsButton" Content="Load settings" Margin="0,0,8,0"/><Button Name="SaveSettingsButton" Content="Save settings"/></WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel></ScrollViewer>
        </Grid>
      </TabItem>
      <TabItem Header="Live output" Name="OutputTab">
        <Grid Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,12"><Button Name="LauncherLogsButton" Content="Open launcher logs" DockPanel.Dock="Right" IsEnabled="False"/><TextBlock Name="LiveStageText" Text="Output appears here after you start discovery." Foreground="#64748B" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel>
          <TextBox Name="LiveOutput" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" Background="#152238" Foreground="#D9E6F6" BorderThickness="0" FontFamily="Consolas" FontSize="13" Padding="16" VerticalContentAlignment="Top" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
        </Grid>
      </TabItem>
      <TabItem Header="Results" Name="ResultsTab">
        <Grid Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Background="White" CornerRadius="8" Padding="22" BorderBrush="#E0E7F1" BorderThickness="1"><StackPanel><TextBlock Name="ResultHeading" Text="No run completed yet" FontSize="21" FontWeight="SemiBold"/><TextBlock Name="ResultSummary" Text="Run results, inventory totals, and collection issues appear here." TextWrapping="Wrap" Foreground="#64748B" Margin="0,8,0,0"/><TextBox Name="ResultPath" IsReadOnly="True" Background="#F7F9FC" Margin="0,14,0,0" ToolTip="Discovery run folder"/></StackPanel></Border>
          <WrapPanel Grid.Row="1" Margin="0,14,0,14"><Button Name="OpenRunButton" Content="Open run folder" IsEnabled="False" Margin="0,0,8,0"/><Button Name="OpenLogButton" Content="Open discovery log" IsEnabled="False" Margin="0,0,8,0"/><Button Name="OpenStatusButton" Content="Open execution status CSV" IsEnabled="False" Margin="0,0,8,0"/><Button Name="OpenIndexButton" Content="Open discovery index" IsEnabled="False"/></WrapPanel>
          <DataGrid Name="IssuesGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal" Background="White" BorderBrush="#E0E7F1" HeadersVisibility="Column" RowHeight="30">
            <DataGrid.Columns><DataGridTextColumn Header="Operation" Binding="{Binding Operation}" Width="2*"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/><DataGridTextColumn Header="Details" Binding="{Binding Message}" Width="3*"/></DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>
    </TabControl>
    <Grid Grid.Row="2" Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center"><TextBlock Name="FooterStatus" Text="Ready to collect inventory." FontWeight="SemiBold"/><TextBlock Name="ElapsedText" Text="No discovery runs until you select Start discovery." Style="{StaticResource Hint}" Margin="0,3,0,0"/></StackPanel>
      <Button Name="StopButton" Grid.Column="1" Content="Stop run" IsEnabled="False" Margin="0,0,10,0" ToolTip="Stops the worker and its child processes. Completed files remain."/>
      <Button Name="StartButton" Grid.Column="2" Content="Start discovery" Background="#1764D8" BorderBrush="#1764D8" Foreground="White" FontWeight="SemiBold" Padding="24,12"/>
    </Grid>
  </Grid>
</Window>
